# Set this last, once everything below is filled in
ENV_VALID=True

# Telegram bot token from @BotFather
BOT_API_KEY=

# PostgreSQL connection string
PG_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Telegram username allowed into the /admin panel
ADMIN_USERNAME=

# Items shown per page inside a room
CONTENT_ITEMS_LIMIT=5

# Password for the bundled PostgreSQL container
POSTGRES_PASSWORD=
